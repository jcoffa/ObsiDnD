#!/bin/bash

BASENAME="$(basename $0)"

usage() {
    echo "Usage: $BASENAME [OPTION...]"
    echo
    echo "OPTIONS:"
    echo "  --no-push                   Don't push local changes after syncing with GitHub"
    echo "  --no-pull                   Don't pull potential new changes from GitHub before trying to push local changes"
    echo "  --push-plugins              Commit and push local plugin configurations to GitHub instead of overwriting"
    echo "                                local plugins with whatever GitHub has. YOU SHOULDN'T NEED TO DO THIS UNLESS"
    echo "                                LOREMASTER TELLS YOU TO"
    echo '  -m | --message "<message>"  Commit message (will be after the sync summary)'
    echo "  --dry-run                   Don't actually do anything; just output the commands that would be performed"
    echo "  -h | --help                 Display this message and exit"
    echo
    echo
    echo "Terminology for the non-programmers:"
    echo "  push = Take the changes you've made on your computer and send them to GitHub so that"
    echo "         other people can see them. Every time you push to GitHub, the published site will"
    echo "         also re-generate itself with your new changes after about 30 seconds."
    echo
    echo "  pull = Take the changes that other people have pushed to GitHub and copy them into the"
    echo "         vault on your own computer."
}

err() {
    >&2 echo "$@"
}

has_autostash() {
    [[ "$(git stash list -n 1)" == "stash@{0}: autostash" ]]
}

user_is_loremaster() {
    [[ "$(git config get --global user.name)" == "Joseph Coffa" ]]
}

pull_changes=0
push_changes=0
push_plugins=1
message=""
dry=''

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --no-push)
            push_changes=1
            shift
            ;;
        --no-pull)
            pull_changes=1
            shift
            ;;
        --push-plugins)
            push_plugins=0
            shift
            ;;
        --dry-run)
            dry=echo
            shift
            ;;
        -m|--message)
            message="$2"
            shift 2
            ;;
        -*|--*)
            err "$BASENAME: Unknown option '$1'"
            usage
            exit 1
            ;;
        *)
            err "$BASENAME: Unexpected positional argument '$1'"
            usage
            exit 1
            ;;
    esac
done

if [[ $push_plugins -ne 0 ]]; then
    if user_is_loremaster; then
        echo "OVERRIDE: Loremaster always pushes plugin configuration"
    else
        $dry git restore --staged --worktree -- content/.obsidian/plugins/
    fi
fi

if [[ $pull_changes -eq 0 ]]; then
    # Quit early if we only need to pull
    if [[ ! `git status --porcelain` ]]; then
        echo "No local changes; just pulling from remote"
        $dry git pull
        exit $?
    fi

    echo ""
    echo "Attempting to Backup -> Pull -> Incorporate local changes"
    echo ""

    # Automatically stash local changes and pop them after a successful pull.
    # This could result in a merge conflict, but in typical scenarios it won't.
    $dry git pull --autostash
    if [[ $? -ne 0 ]]; then
        err ""
        err " !! ERROR DETECTED !!"
        err "======================"
        err "You may have gotten a merge conflict in the process of incorporating local changes."
        err "If so, you will need to resolve these conflicts using normal git process."
        err "If you are a non-compsci user, ping The Loremaster in the group chat for help!"
        exit 1
    fi
fi

if [[ $push_changes -ne 0 ]]; then
    echo "Sync successful"
    exit 0
fi

echo ""
echo "Attempting to Commit -> Push -> Delete backup"
echo ""

# Construct commit message
if [[ -n "$message" ]]; then
    message=$(printf "\n\n$message")
fi
message="Sync by $(git config user.name) on $(date "+%B %-d, %Y at %-I:%M %p (%Z)")$message"

# Perform commit
$dry git add . && \
    $dry git commit -m "$message" && \
    $dry git push
if [[ $? -eq 0 ]] && has_autostash; then
    echo "Sync successful. Deleting backup."
    $dry git stash drop
fi

echo ""
